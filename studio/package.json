{
  "name": "cuby-studio-variant-a",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --configLoader runner --mode public",
    "share-audit": "node tools/share-audit.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "smoke": "node tools/interact.mjs && node tools/interact.mjs --mobile",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@monogrid/gainmap-js": "^3.7.3",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-clouds": "^0.7.6",
    "@takram/three-geospatial": "^0.9.1",
    "camera-controls": "^3.1.2",
    "konva": "^10.9.1",
    "n8ao": "^2.1.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.10.0",
    "xatlas-web": "^0.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.95.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
